# xKiro (OpenAI-compatible chat-completions API)
# Set XKIRO_API_KEY in your local .env or Render Environment dashboard.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/devstral-medium

# OAuth app credentials are configured once by the Forge deployment owner; users then sign in normally.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback URL registered in the GitHub OAuth App.
GITHUB_REDIRECT_URI=
# Stable secret used to encrypt connected-account tokens at rest.
OAUTH_ENCRYPTION_SECRET=

# Optional legacy/service-account credentials.
GITHUB_TOKEN=
RENDER_API_KEY=
APP_PASSWORD=change-this-to-a-long-random-password
ALLOW_SHELL=0
GIT_NAME=
GIT_EMAIL=
SANDBOX_DOCKER=0
SANDBOX_ALLOW_HOST_EXECUTION=0
SANDBOX_NETWORK=0
# Optional: change workspace location. Render's filesystem is ephemeral unless a disk is attached.
WORKSPACE=workspace
