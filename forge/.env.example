# xKiro (OpenAI-compatible chat-completions API)
# Set XKIRO_API_KEY in your local .env or Vercel Environment Variables.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=qwen/qwen3.8-omni-flash:free

# OAuth app credentials are configured once by the Forge deployment owner; users then sign in normally.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback URL registered in the GitHub OAuth App.
GITHUB_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/auth/github/callback
GITHUB_ALLOWED_USERS=your-github-login
FORGE_SESSION_SECRET=
# Stable secret used to encrypt connected-account tokens at rest.
OAUTH_ENCRYPTION_SECRET=

# Optional legacy/service-account credentials.
GITHUB_TOKEN=
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
ALLOW_SHELL=0
GIT_NAME=
GIT_EMAIL=
SANDBOX_VERCEL=1
SANDBOX_RENDER=0
SANDBOX_DOCKER=0
SANDBOX_ALLOW_HOST_EXECUTION=0
# Enables pip/npm and other outbound network requests inside the isolated sandbox only.
SANDBOX_NETWORK=1
VERCEL_SANDBOX_REGION=bom1
# Optional Vercel Container Registry image override; defaults to vercel/sandbox/universal:latest.
VERCEL_SANDBOX_IMAGE=
VERCEL_PREVIEW_TIMEOUT=3600
# Local workspace staging path; Vercel function filesystems are ephemeral.
WORKSPACE=workspace

# Optional task-specific model routing (leave all blank to use the primary xKiro model).
FORGE_CODING_API_KEY=
FORGE_CODING_BASE_URL=
FORGE_CODING_MODEL=
FORGE_CODING_KIND=openai
FORGE_REVIEW_API_KEY=
FORGE_REVIEW_BASE_URL=
FORGE_REVIEW_MODEL=
FORGE_REVIEW_KIND=openai
FORGE_SUMMARY_API_KEY=
FORGE_SUMMARY_BASE_URL=
FORGE_SUMMARY_MODEL=
FORGE_SUMMARY_KIND=openai
