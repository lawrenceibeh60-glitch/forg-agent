# Kiro (any OpenAI-compatible chat-completions endpoint works)
KIRO_API_KEY=your-key
KIRO_BASE_URL=https://YOUR-KIRO-ENDPOINT/v1
KIRO_MODEL=your-model-name
GITHUB_TOKEN=ghp_xxx
RENDER_API_KEY=rnd_xxx
ALLOW_SHELL=1
APP_PASSWORD=   # optional: set to require a login
OPENAI_NOTE=Models/keys are added in the app: Settings → Models
GIT_NAME=            # optional commit identity (defaults to your GitHub profile)
GIT_EMAIL=
SANDBOX_DOCKER=0     # 1 = run shell commands inside Docker for hard isolation
